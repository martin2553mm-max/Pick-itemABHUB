-- DEX HUB — Item Pickup Script
-- ดึงระบบ pickup_dropped_item จากสคริปต์ต้นฉบับและรวม UI ไว้ในไฟล์นี้

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local pickupEnabled = false
local pickupRadius = 20
local pickupInterval = 0.08
local lastScan = 0
local itemCooldown = {}
local networkState

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local getRemote = remotes:WaitForChild("Get")

-- เกมนี้ใช้ตารางภายในที่มีตัวนับ event/func ก่อนเรียก RemoteFunction
local function findNetworkState()
    if typeof(getgc) ~= "function" then
        return nil
    end

    local success, objects = pcall(getgc, true)
    if not success then
        return nil
    end

    for _, object in ipairs(objects) do
        if typeof(object) == "table"
            and rawget(object, "event") ~= nil
            and rawget(object, "func") ~= nil then
            return object
        end
    end

    return nil
end

local function getRootPart()
    local character = player.Character
    if not character then
        return nil
    end
    return character:FindFirstChild("HumanoidRootPart")
end

local function requestPickup(item)
    if not networkState or typeof(networkState.func) ~= "number" then
        networkState = findNetworkState()
    end
    if not networkState then
        return false
    end

    networkState.func = networkState.func + 1
    local success = pcall(function()
        getRemote:InvokeServer(networkState.func, "pickup_dropped_item", item)
    end)
    return success
end

local function scanDroppedItems()
    if not pickupEnabled then
        return
    end

    local rootPart = getRootPart()
    local droppedItems = workspace:FindFirstChild("DroppedItems")
    if not rootPart or not droppedItems then
        return
    end

    local now = os.clock()
    for _, item in ipairs(droppedItems:GetChildren()) do
        if item:IsA("Model") then
            local itemPart = item:FindFirstChildWhichIsA("BasePart")
            if itemPart and (rootPart.Position - itemPart.Position).Magnitude <= pickupRadius then
                if now - (itemCooldown[item] or 0) >= 0.2 then
                    itemCooldown[item] = now
                    task.spawn(requestPickup, item)
                end
            end
        end
    end

    for item in pairs(itemCooldown) do
        if item.Parent == nil then
            itemCooldown[item] = nil
        end
    end
end

