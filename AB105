local function refreshToggle()
    toggle.BackgroundColor3 = pickupEnabled
        and Color3.fromRGB(201, 55, 55)
        or Color3.fromRGB(54, 57, 66)
    knob.BackgroundColor3 = pickupEnabled
        and Color3.fromRGB(255, 255, 255)
        or Color3.fromRGB(205, 208, 214)
    knob:TweenPosition(
        pickupEnabled and UDim2.fromOffset(29, 3) or UDim2.fromOffset(3, 3),
        Enum.EasingDirection.Out,
        Enum.EasingStyle.Quad,
        0.14,
        true
    )
end

